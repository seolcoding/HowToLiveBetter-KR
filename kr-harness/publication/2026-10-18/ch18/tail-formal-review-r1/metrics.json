{
  "raw_sha256": "958d6bf79293c79f8a93c40415ef41627a5d964cd148ed0bbce6e28ee127e8d3",
  "cli_start": "49a5393886e90f65cac08885673501b786549a1d968a8bc6149526ec4d732d2e",
  "production_AST_intro_and_all6entries_identical": true,
  "exact4operations_and_banner_only": true,
  "todo_items": 5,
  "entries": [
    {
      "number": "1",
      "entry_sha256": "df797336e62060c92c330e29f7db5c647ace67a6b812db6406d01a9f3639fb62",
      "heading_chars_excluding_markup_number": 35,
      "easy_chars": 119,
      "easy_sentences": 4,
      "narrative_max": 49,
      "sentences": [
        {
          "field": "비용",
          "text": "돈 안 듭니다.",
          "chars": 8
        },
        {
          "field": "비용",
          "text": "출생신고를 할 때 주민센터에서 함께 신청하거나 복지로·정부24에서 신청합니다.",
          "chars": 43
        },
        {
          "field": "비용",
          "text": "출생일을 포함해 60일 안에 신청해야 태어난 달 치부터 받습니다.",
          "chars": 36
        },
        {
          "field": "쉽게",
          "text": "첫만남이용권은 첫째 200만 원, 둘째부터 300만 원입니다.",
          "chars": 34
        },
        {
          "field": "쉽게",
          "text": "부모급여는 첫돌 전 월 100만 원, 첫돌부터 두 돌 전 월 50만 원입니다.",
          "chars": 43
        },
        {
          "field": "쉽게",
          "text": "어린이집 보육료는 여기서 빠집니다.",
          "chars": 19
        },
        {
          "field": "쉽게",
          "text": "아동수당 월 10만 원은 별도입니다.",
          "chars": 20
        },
        {
          "field": "이득",
          "text": "첫만남이용권은 아이가 태어나면 한 번에 줍니다.",
          "chars": 26
        },
        {
          "field": "이득",
          "text": "첫째는 200만 원, 둘째부터는 300만 원입니다.",
          "chars": 28
        },
        {
          "field": "이득",
          "text": "근거: 「아동수당법」 제10조의2, 같은 법 시행령 제10조의3 제1항.",
          "chars": 40
        },
        {
          "field": "이득",
          "text": "이용권은 보호자 카드에 넣어 줍니다.",
          "chars": 20
        },
        {
          "field": "이득",
          "text": "카드 이용권은 아이가 태어난 날부터 2년 안에 써야 합니다.",
          "chars": 33
        },
        {
          "field": "이득",
          "text": "근거: 시행령 제10조의3 제5항·제6항.",
          "chars": 23
        },
        {
          "field": "이득",
          "text": "2세 미만 아동에게는 아동수당과 별도로 돈을 \"추가로\" 줍니다(같은 법 제4조 제5항).",
          "chars": 49
        },
        {
          "field": "이득",
          "text": "보건복지부는 이 돈을 부모급여라고 부릅니다.",
          "chars": 24
        },
        {
          "field": "이득",
          "text": "1세 미만은 매월 100만 원을 받습니다.",
          "chars": 23
        },
        {
          "field": "이득",
          "text": "1세 이상 2세 미만은 매월 50만 원입니다(시행령 제2조 제1항).",
          "chars": 38
        },
        {
          "field": "이득",
          "text": "부모급여는 보육료를 포함한 지원액입니다.",
          "chars": 22
        },
        {
          "field": "이득",
          "text": "어린이집에 다니면 기본보육료를 뺀 차액만 현금으로 나옵니다.",
          "chars": 33
        },
        {
          "field": "이득",
          "text": "2026년 0세 아이는 100만 원에서 58만 4천 원을 뺀 41만 6천 원을 받습니다.",
          "chars": 49
        },
        {
          "field": "이득",
          "text": "어린이집을 이용하는 1세 아이는 보육료가 51만 5천 원이어서 현금 차액이 없습니다.",
          "chars": 47
        },
        {
          "field": "이득",
          "text": "아동수당은 매월 10만 원입니다.",
          "chars": 18
        },
        {
          "field": "이득",
          "text": "2026년에는 원칙적으로 9세 미만까지 받습니다(같은 법 제4조 제1항, 부칙 제2조).",
          "chars": 49
        },
        {
          "field": "이득",
          "text": "다만 2017년생은 2026~2029년에 나이 도래와 관계없이 매월 받습니다.",
          "chars": 43
        },
        {
          "field": "이득",
          "text": "지급 나이는 해마다 한 살씩 올라 2030년부터 13세 미만이 됩니다.",
          "chars": 39
        },
        {
          "field": "이득",
          "text": "사는 곳에 따라 더 주는 지역 추가분도 있습니다.",
          "chars": 27
        },
        {
          "field": "이득",
          "text": "인구감소지역을 제외한 비수도권은 매월 5천 원을 더 줍니다.",
          "chars": 33
        },
        {
          "field": "이득",
          "text": "인구감소지역은 매월 1만~2만 원을 더 줍니다(시행령 제2조 제2항).",
          "chars": 39
        },
        {
          "field": "이득",
          "text": "출생일을 포함해 60일 안에 신청하면 태어난 달 치부터 소급해 받습니다.",
          "chars": 40
        },
        {
          "field": "이득",
          "text": "근거: 같은 법 제10조 제2항.",
          "chars": 18
        },
        {
          "field": "비고",
          "text": "첫만남이용권·부모급여·기본 아동수당은 전국 공통입니다.",
          "chars": 30
        },
        {
          "field": "비고",
          "text": "시·군·구가 조례로 따로 주는 출산지원금이 있는지는 주소지 주민센터에 물어보세요.",
          "chars": 45
        },
        {
          "field": "비고",
          "text": "회사에서 받는 출산지원금은 두 번까지 소득세가 붙지 않습니다.",
          "chars": 34
        },
        {
          "field": "비고",
          "text": "다만 사용자와 법령상 특수관계에 있는 사람은 제외됩니다.",
          "chars": 31
        },
        {
          "field": "비고",
          "text": "아이가 태어난 날부터 2년 안에 대통령령이 정한 방식으로 받은 돈이어야 합니다.",
          "chars": 44
        },
        {
          "field": "비고",
          "text": "근거: 「소득세법」 제12조 제3호 머목.",
          "chars": 23
        },
        {
          "field": "비고",
          "text": "아동수당과 부모급여로 받은 돈은 압류할 수 없습니다(「아동수당법」 제18조).",
          "chars": 43
        },
        {
          "field": "비고",
          "text": "받는 돈은 대부분 두 돌 전에 몰려 있습니다.",
          "chars": 25
        },
        {
          "field": "비고",
          "text": "두 돌이 지나면 아동수당 월 10만 원과 지역 추가분만 남습니다.",
          "chars": 36
        },
        {
          "field": "비고",
          "text": "그러니 받을 돈만 보고 아이를 낳을지 정하지는 마세요.",
          "chars": 30
        },
        {
          "field": "비고",
          "text": "2026-10-18 법령·복지부 안내 확인.",
          "chars": 24
        }
      ]
    },
    {
      "number": "2",
      "entry_sha256": "b09f090774ae909400e95701e09bcec3dc5252444e2f243f39d247f7c1a8aa90",
      "heading_chars_excluding_markup_number": 25,
      "easy_chars": 113,
      "easy_sentences": 3,
      "narrative_max": 49,
      "sentences": [
        {
          "field": "비용",
          "text": "돈 안 듭니다.",
          "chars": 8
        },
        {
          "field": "비용",
          "text": "회사가 고용센터에 휴가 확인서를 내면 본인이 고용24에서 급여를 신청합니다.",
          "chars": 42
        },
        {
          "field": "쉽게",
          "text": "출산휴가는 90일(미숙아 100일·다태아 120일)입니다.",
          "chars": 32
        },
        {
          "field": "쉽게",
          "text": "처음 60일(다태아 75일)은 보험급여가 없어도 회사가 통상임금을 줍니다.",
          "chars": 41
        },
        {
          "field": "쉽게",
          "text": "이후는 요건을 갖춰 보험급여만 받으며 30일에 220만 원까지입니다.",
          "chars": 38
        },
        {
          "field": "이득",
          "text": "회사는 출산 전후를 합쳐 90일의 출산전후휴가를 줘야 합니다.",
          "chars": 34
        },
        {
          "field": "이득",
          "text": "미숙아는 100일, 한 번에 둘 이상 임신하면 120일입니다.",
          "chars": 34
        },
        {
          "field": "이득",
          "text": "휴가 가운데 45일(둘 이상은 60일) 이상은 출산 뒤에 써야 합니다.",
          "chars": 39
        },
        {
          "field": "이득",
          "text": "근거는 「근로기준법」 제74조 제1항입니다.",
          "chars": 24
        },
        {
          "field": "이득",
          "text": "이 가운데 처음 60일(둘 이상은 75일)은 유급입니다(같은 조 제4항).",
          "chars": 41
        },
        {
          "field": "이득",
          "text": "휴가 급여는 고용보험이 줍니다.",
          "chars": 17
        },
        {
          "field": "이득",
          "text": "받으려면 휴가가 끝난 날까지 피보험 단위기간이 합쳐서 180일 이상이어야 합니다.",
          "chars": 45
        },
        {
          "field": "이득",
          "text": "근거는 「고용보험법」 제75조입니다.",
          "chars": 20
        },
        {
          "field": "이득",
          "text": "금액은 휴가 시작일 기준 통상임금입니다(같은 법 제76조 제1항).",
          "chars": 37
        },
        {
          "field": "이득",
          "text": "통상임금은 정기적으로 정해져 나오는 임금을 말합니다.",
          "chars": 29
        },
        {
          "field": "이득",
          "text": "고용보험 급여 상한은 90일에 660만 원이고 30일로 치면 220만 원입니다.",
          "chars": 44
        },
        {
          "field": "이득",
          "text": "미숙아는 100일에 733만 3330원까지 받습니다.",
          "chars": 29
        },
        {
          "field": "이득",
          "text": "둘 이상 임신하면 120일에 880만 원까지입니다(고용노동부고시 제2026-67호).",
          "chars": 47
        },
        {
          "field": "이득",
          "text": "우선지원 대상기업이면 휴가 기간 전체에 고용보험 급여가 상한 안에서 나옵니다.",
          "chars": 43
        },
        {
          "field": "이득",
          "text": "여기에는 업종별 근로자 수 기준에 드는 기업과 중소기업이 들어갑니다.",
          "chars": 38
        },
        {
          "field": "이득",
          "text": "다만 상호출자제한기업집단 소속 회사는 빠집니다(「고용보험법 시행령」 제12조).",
          "chars": 44
        },
        {
          "field": "이득",
          "text": "그 밖의 기업이면 고용보험은 60일(둘 이상은 75일)을 넘는 기간 치만 줍니다.",
          "chars": 45
        },
        {
          "field": "이득",
          "text": "이때 고용보험이 주는 일수는 최대 30일입니다.",
          "chars": 26
        },
        {
          "field": "이득",
          "text": "미숙아는 40일, 둘 이상은 45일까지입니다(「고용보험법」 제76조 제1항 제1호).",
          "chars": 47
        },
        {
          "field": "이득",
          "text": "처음 60일(둘 이상은 75일)은 회사 규모와 상관없이 통상임금 전액이 나와야 합니다.",
          "chars": 48
        },
        {
          "field": "이득",
          "text": "우선지원 대상기업도 이 기간에 통상임금이 상한을 넘으면 그 차액은 회사가 줘야 합니다.",
          "chars": 48
        },
        {
          "field": "이득",
          "text": "그 밖의 기업은 이 기간 임금을 회사가 전부 줍니다(「근로기준법」 제74조 제4항).",
          "chars": 47
        },
        {
          "field": "이득",
          "text": "60일(둘 이상은 75일)이 지난 뒤에는 고용보험 급여만 나옵니다.",
          "chars": 37
        },
        {
          "field": "이득",
          "text": "회사는 상한을 넘는 차액을 채워 줄 의무가 없습니다.",
          "chars": 29
        },
        {
          "field": "이득",
          "text": "급여는 휴가 시작 1개월 뒤부터 휴가가 끝나고 12개월 안에 신청하세요.",
          "chars": 40
        },
        {
          "field": "이득",
          "text": "근거는 「고용보험법」 제75조 제2호입니다.",
          "chars": 24
        },
        {
          "field": "이득",
          "text": "그 밖의 기업은 휴가 시작 60일(둘 이상은 75일)이 지나고 1개월 뒤부터 신청합니다.",
          "chars": 49
        },
        {
          "field": "이득",
          "text": "고용보험 급여가 안 나와도 회사는 처음 60일을 유급으로 해야 합니다.",
          "chars": 39
        },
        {
          "field": "이득",
          "text": "근거는 「근로기준법」 제74조 제4항입니다.",
          "chars": 24
        },
        {
          "field": "이득",
          "text": "소득활동을 해도 고용보험 출산전후휴가급여를 못 받는 출산 여성이 있습니다.",
          "chars": 41
        },
        {
          "field": "이득",
          "text": "이런 경우 고용보험 미적용자 출산급여 대상인지 확인하세요.",
          "chars": 32
        },
        {
          "field": "이득",
          "text": "1인 사업자·프리랜서 등 유형별 선정 요건을 충족해야 합니다.",
          "chars": 34
        },
        {
          "field": "이득",
          "text": "대상자는 총 150만 원을 한 번에 받습니다.",
          "chars": 25
        },
        {
          "field": "이득",
          "text": "출산일부터 1년 안에 신청하세요.",
          "chars": 18
        },
        {
          "field": "이득",
          "text": "소득활동 증빙과 유형별 요건은 정부24 안내에서 확인하세요.",
          "chars": 33
        },
        {
          "field": "비고",
          "text": "90일은 법이 정한 최소한입니다.",
          "chars": 18
        },
        {
          "field": "비고",
          "text": "배우자는 배우자 출산전후휴가 20일을 유급으로 씁니다.",
          "chars": 30
        },
        {
          "field": "비고",
          "text": "기간은 출산 예정일 50일 전부터 출산 후 120일까지입니다.",
          "chars": 34
        },
        {
          "field": "비고",
          "text": "그 안에서 세 번까지 나눠 쓸 수 있습니다.",
          "chars": 24
        },
        {
          "field": "비고",
          "text": "근거는 「남녀고용평등과 일·가정 양립 지원에 관한 법률」 제18조의2입니다.",
          "chars": 42
        },
        {
          "field": "비고",
          "text": "그 뒤로는 부모가 각자 육아휴직을 1년까지 씁니다.",
          "chars": 28
        },
        {
          "field": "비고",
          "text": "같은 아이를 두고 부모가 각각 3개월 이상 쓰면 6개월까지 더 쓸 수 있습니다.",
          "chars": 44
        },
        {
          "field": "비고",
          "text": "근거는 같은 법 제19조 제2항입니다.",
          "chars": 21
        },
        {
          "field": "비고",
          "text": "육아휴직 급여의 일반 기준은 첫 3개월에 월 통상임금을 받고 상한은 250만 원입니다.",
          "chars": 48
        },
        {
          "field": "비고",
          "text": "4~6개월째는 상한이 200만 원으로 내려갑니다.",
          "chars": 27
        },
        {
          "field": "비고",
          "text": "7개월째부터는 통상임금의 80%를 주고 상한은 160만 원입니다.",
          "chars": 36
        },
        {
          "field": "비고",
          "text": "근거는 「고용보험법 시행령」 제95조입니다.",
          "chars": 24
        },
        {
          "field": "비고",
          "text": "자녀 연령·근속 등 신청 요건은 신청 전에 고용24나 고용센터에서 확인하세요.",
          "chars": 43
        },
        {
          "field": "비고",
          "text": "부모 모두 사용·한부모 급여 특례의 적용 여부도 확인하세요.",
          "chars": 33
        },
        {
          "field": "비고",
          "text": "출산전후휴가 급여와 육아휴직 급여에는 소득세가 붙지 않습니다.",
          "chars": 34
        },
        {
          "field": "비고",
          "text": "근거는 「소득세법」 제12조 제3호 마목입니다.",
          "chars": 26
        },
        {
          "field": "비고",
          "text": "상한액 고시는 2026년 12월 31일까지 유효합니다.",
          "chars": 30
        },
        {
          "field": "비고",
          "text": "2026-10-10 법령 확인(국가법령정보센터).",
          "chars": 27
        },
        {
          "field": "비고",
          "text": "2026-10-18 기준 확인.",
          "chars": 17
        },
        {
          "field": "비고",
          "text": "유효기간이 지난 상한액은 신청 전에 다시 확인하세요.",
          "chars": 29
        }
      ]
    },
    {
      "number": "3",
      "entry_sha256": "c6c7c3c3356d0028865ca24f2738f38e91abc874aa4f11eafbf9aba90567ea38",
      "heading_chars_excluding_markup_number": 55,
      "easy_chars": 117,
      "easy_sentences": 4,
      "narrative_max": 50,
      "sentences": [
        {
          "field": "비용",
          "text": "출산 보호 권리를 알아보는 데 돈은 들지 않습니다.",
          "chars": 28
        },
        {
          "field": "비용",
          "text": "분쟁 절차의 수수료는 별도 확인이 필요합니다.",
          "chars": 25
        },
        {
          "field": "쉽게",
          "text": "출산휴가 중과 끝난 뒤 30일은 원칙적으로 해고할 수 없습니다.",
          "chars": 35
        },
        {
          "field": "쉽게",
          "text": "회사는 복귀 때 같은 일이나 같은 임금의 자리를 줘야 합니다.",
          "chars": 34
        },
        {
          "field": "쉽게",
          "text": "임신 중 연장근로는 금지됩니다.",
          "chars": 17
        },
        {
          "field": "쉽게",
          "text": "임신기 단축근무를 이유로 월급을 깎을 수 없습니다.",
          "chars": 28
        },
        {
          "field": "이득",
          "text": "회사는 산전·산후 휴가 기간과 그 뒤 30일 동안 해고하지 못합니다.",
          "chars": 38
        },
        {
          "field": "이득",
          "text": "「근로기준법」 제23조 제2항에 따른 제한입니다.",
          "chars": 27
        },
        {
          "field": "이득",
          "text": "회사가 사업을 계속할 수 없게 된 경우 등은 예외입니다.",
          "chars": 31
        },
        {
          "field": "이득",
          "text": "어기면 5년 이하 징역 또는 5천만 원 이하 벌금을 받습니다(같은 법 제107조).",
          "chars": 46
        },
        {
          "field": "이득",
          "text": "임신 중에는 시간외근로를 시키지 못합니다.",
          "chars": 23
        },
        {
          "field": "이득",
          "text": "본인이 원하면 쉬운 일로 바꿔 줘야 합니다(같은 법 제74조 제5항).",
          "chars": 39
        },
        {
          "field": "이득",
          "text": "임신 12주 이내 또는 32주 이후에는 하루 2시간 단축근무를 신청할 수 있습니다.",
          "chars": 46
        },
        {
          "field": "이득",
          "text": "고용노동부령으로 정한 유산·조산 위험이 있는 근로자는 임신 전 기간에 신청할 수 있습니다.",
          "chars": 50
        },
        {
          "field": "이득",
          "text": "하루 근로시간이 8시간 미만인 경우도 있습니다.",
          "chars": 26
        },
        {
          "field": "이득",
          "text": "이때 회사는 하루 근로시간이 6시간이 되도록 단축을 허용할 수 있습니다.",
          "chars": 40
        },
        {
          "field": "이득",
          "text": "회사는 이를 허용해야 하고 단축을 이유로 임금을 깎지 못합니다(같은 조 제7항·제8항).",
          "chars": 49
        },
        {
          "field": "이득",
          "text": "휴가가 끝나면 휴가 전 업무나 같은 임금 수준의 직무로 돌려보내야 합니다.",
          "chars": 41
        },
        {
          "field": "이득",
          "text": "같은 조 제6항에 따른 의무입니다.",
          "chars": 19
        },
        {
          "field": "이득",
          "text": "어기면 500만 원 이하 벌금입니다(같은 법 제114조).",
          "chars": 32
        },
        {
          "field": "이득",
          "text": "생후 1년 미만 아이를 둔 여성 근로자는 유급 수유 시간을 청구할 수 있습니다.",
          "chars": 44
        },
        {
          "field": "이득",
          "text": "수유 시간은 하루 두 번, 각각 30분 이상입니다(같은 법 제75조).",
          "chars": 39
        },
        {
          "field": "이득",
          "text": "임신 중이거나 산후 1년이 안 된 여성에게는 야간과 휴일에 일을 시키지 못합니다.",
          "chars": 45
        },
        {
          "field": "이득",
          "text": "여기서 야간은 밤 10시부터 아침 6시 사이를 말합니다.",
          "chars": 31
        },
        {
          "field": "이득",
          "text": "임신 중에는 본인이 명시적으로 청구해야 합니다.",
          "chars": 26
        },
        {
          "field": "이득",
          "text": "산후 1년이 안 된 경우에는 본인이 동의해야 합니다.",
          "chars": 29
        },
        {
          "field": "이득",
          "text": "두 경우 모두 고용노동부장관 인가를 받아야 예외가 됩니다(같은 법 제70조 제2항).",
          "chars": 47
        },
        {
          "field": "이득",
          "text": "산후 1년이 안 된 여성의 시간외근로에는 한도가 있습니다.",
          "chars": 32
        },
        {
          "field": "이득",
          "text": "하루 2시간, 한 주 6시간, 한 해 150시간까지만 시킬 수 있습니다.",
          "chars": 40
        },
        {
          "field": "이득",
          "text": "같은 법 제71조에 따른 한도입니다.",
          "chars": 20
        },
        {
          "field": "이득",
          "text": "출산전후휴가, 수유 시간, 야간·시간외 제한을 어긴 회사는 처벌받습니다.",
          "chars": 40
        },
        {
          "field": "이득",
          "text": "형량은 2년 이하 징역 또는 2천만 원 이하 벌금입니다(같은 법 제110조).",
          "chars": 43
        },
        {
          "field": "이득",
          "text": "회사는 혼인·임신·출산을 퇴직 사유로 미리 정한 근로계약을 맺을 수 없습니다.",
          "chars": 43
        },
        {
          "field": "이득",
          "text": "어기면 5년 이하 징역 또는 3천만 원 이하 벌금입니다.",
          "chars": 31
        },
        {
          "field": "이득",
          "text": "「남녀고용평등과 일·가정 양립 지원에 관한 법률」 제11조 제2항에 따른 금지입니다.",
          "chars": 47
        },
        {
          "field": "이득",
          "text": "벌칙은 같은 법 제37조 제1항에 있습니다.",
          "chars": 24
        },
        {
          "field": "이득",
          "text": "육아휴직을 이유로 해고하거나 불리하게 대우해도 처벌받습니다.",
          "chars": 33
        },
        {
          "field": "이득",
          "text": "이때 벌칙은 3년 이하 징역 또는 3천만 원 이하 벌금입니다.",
          "chars": 34
        },
        {
          "field": "이득",
          "text": "같은 법 제19조 제3항, 제37조 제2항에 따른 처벌입니다.",
          "chars": 34
        },
        {
          "field": "비고",
          "text": "상시 4명 이하 사업장에도 해고 금지(제23조 제2항)는 적용됩니다.",
          "chars": 38
        },
        {
          "field": "비고",
          "text": "출산전후휴가(제74조)도 적용됩니다.",
          "chars": 20
        },
        {
          "field": "비고",
          "text": "야간·휴일과 시간외 제한(제70조 제2항, 제71조)도 마찬가지입니다.",
          "chars": 39
        },
        {
          "field": "비고",
          "text": "반면 수유 시간(제75조)은 4명 이하 사업장에는 적용되지 않습니다.",
          "chars": 38
        },
        {
          "field": "비고",
          "text": "부당해고 구제신청(제28조)도 적용되지 않습니다.",
          "chars": 27
        },
        {
          "field": "비고",
          "text": "근로기준법 시행령 별표 1에 따른 구분입니다.",
          "chars": 25
        },
        {
          "field": "비고",
          "text": "5명 이상 사업장에서 부당하게 잘렸다면 노동위원회에 구제를 신청하세요.",
          "chars": 39
        },
        {
          "field": "비고",
          "text": "기한은 해고된 날부터 3개월입니다(제28조).",
          "chars": 25
        },
        {
          "field": "비고",
          "text": "노동위원회는 원칙적으로 사건 접수일부터 60일 안에 심문회의를 엽니다.",
          "chars": 39
        },
        {
          "field": "비고",
          "text": "다만 당사자의 신청이나 업무처리 일정상 사건 처리가 지연되면 심문일정이 연기됩니다.",
          "chars": 46
        },
        {
          "field": "비고",
          "text": "월평균 임금이 300만 원 미만이면 공인노무사나 변호사의 도움을 무료로 받을 수 있습니다.",
          "chars": 50
        },
        {
          "field": "비고",
          "text": "법 위반은 고용노동부나 근로감독관에게 신고해도 됩니다.",
          "chars": 30
        },
        {
          "field": "비고",
          "text": "회사는 신고를 이유로 불이익을 줄 수 없습니다(제104조).",
          "chars": 33
        },
        {
          "field": "비고",
          "text": "상담은 고용노동부 고객상담센터 1350에서 받습니다.",
          "chars": 29
        },
        {
          "field": "비고",
          "text": "해고·전보·감봉 통지서와 메신저 대화는 증거로 남겨 두세요.",
          "chars": 33
        },
        {
          "field": "비고",
          "text": "다투는 절차 전체는 제19절(재직·퇴사·산재)을 보세요.",
          "chars": 31
        },
        {
          "field": "비고",
          "text": "2026-10-18 법령·노동위원회 안내 확인.",
          "chars": 26
        }
      ]
    },
    {
      "number": "4",
      "entry_sha256": "2b3ac04323171ad2f31a44869066f5dbcc4c7aaf7e98d6d34561199561359d65",
      "heading_chars_excluding_markup_number": 41,
      "easy_chars": 89,
      "easy_sentences": 3,
      "narrative_max": 46,
      "sentences": [
        {
          "field": "비용",
          "text": "아이를 직접 돌보는 데는 시간이 듭니다.",
          "chars": 22
        },
        {
          "field": "비용",
          "text": "아이가 어릴 때는 돌봄에 많은 시간이 들 수 있습니다.",
          "chars": 30
        },
        {
          "field": "비용",
          "text": "며칠 이를 악물고 버틴다고 끝나는 일이 아닙니다.",
          "chars": 27
        },
        {
          "field": "비용",
          "text": "이 일이 매일 이어져서 어렵습니다.",
          "chars": 19
        },
        {
          "field": "쉽게",
          "text": "아이를 돌보거나 밤에 깨서 쓰는 시간을 합쳐 담당자의 시급을 곱해 보세요.",
          "chars": 41
        },
        {
          "field": "쉽게",
          "text": "분유·기저귀값과 함께 양육비로 적습니다.",
          "chars": 22
        },
        {
          "field": "쉽게",
          "text": "누가 무엇을 맡을지 낳기 전에 정해 두세요.",
          "chars": 24
        },
        {
          "field": "이득",
          "text": "매일 아이를 돌보거나 밤에 깨서 쓰는 시간을 합칩니다.",
          "chars": 30
        },
        {
          "field": "이득",
          "text": "여기에 그 일을 하는 사람의 시급을 곱합니다.",
          "chars": 25
        },
        {
          "field": "이득",
          "text": "이렇게 계산한 시간 비용을 분유·기저귀값과 함께 적습니다.",
          "chars": 32
        },
        {
          "field": "이득",
          "text": "돌보기, 밥하기, 밤중에 일어나기에 돈을 받지 않더라도 비용으로 계산합니다.",
          "chars": 42
        },
        {
          "field": "이득",
          "text": "계산법은 제10절(연애와 결혼의 가성비)에서 집안일을 따진 방식과 같습니다.",
          "chars": 42
        },
        {
          "field": "이득",
          "text": "역할부터 정한 뒤에 낳을지 결정합니다.",
          "chars": 21
        },
        {
          "field": "비고",
          "text": "숫자를 정확히 맞출 필요는 없습니다.",
          "chars": 20
        },
        {
          "field": "비고",
          "text": "두 사람이 낳기 전에 같은 표를 놓고 역할을 정해 보세요.",
          "chars": 32
        },
        {
          "field": "비고",
          "text": "분담을 미리 이야기하자는 제안이며, 출산 뒤 다투지 않는다고 보장할 수는 없습니다.",
          "chars": 46
        }
      ]
    },
    {
      "number": "5",
      "entry_sha256": "338ccda248fce3603b6d56f8e4c7ed808bc8a888b41abac0d33ca81af20dba8d",
      "heading_chars_excluding_markup_number": 39,
      "easy_chars": 114,
      "easy_sentences": 4,
      "narrative_max": 50,
      "sentences": [
        {
          "field": "비용",
          "text": "얼마가 드는지 정해진 숫자는 없습니다.",
          "chars": 21
        },
        {
          "field": "비용",
          "text": "사는 도시와 키우는 방식에 따라 차이가 큽니다.",
          "chars": 26
        },
        {
          "field": "비용",
          "text": "어려운 건 감으로 숫자 하나를 찍지 않고 세 구간으로 나눠 차분히 계산하는 일입니다.",
          "chars": 47
        },
        {
          "field": "쉽게",
          "text": "저자 경험에 따른 설명입니다.",
          "chars": 16
        },
        {
          "field": "쉽게",
          "text": "0~3세 비용은 주로 부모·조부모가 직접 보는지, 사람을 쓰는지에 달렸습니다.",
          "chars": 43
        },
        {
          "field": "쉽게",
          "text": "초등학교·중학교 때는 집값과 학원비가 큰 몫입니다.",
          "chars": 28
        },
        {
          "field": "쉽게",
          "text": "이후에는 진학 경로에 따라 크게 달라집니다.",
          "chars": 24
        },
        {
          "field": "이득",
          "text": "다음은 저자 경험에 따른 계산 항목입니다.",
          "chars": 23
        },
        {
          "field": "이득",
          "text": "0~3세 비용에서 가장 큰 몫은 누가 아이를 돌보느냐입니다.",
          "chars": 33
        },
        {
          "field": "이득",
          "text": "부모가 직접 보는지, 조부모가 보는지, 사람을 쓰는지에 따라 갈립니다.",
          "chars": 39
        },
        {
          "field": "이득",
          "text": "초등학교 6년과 중학교 3년은 의무교육입니다(「교육기본법」 제8조).",
          "chars": 38
        },
        {
          "field": "이득",
          "text": "이 시기에는 집값·전월세와 사교육비가 큰 몫을 차지합니다.",
          "chars": 32
        },
        {
          "field": "이득",
          "text": "중학교를 마친 뒤에는 진학 경로가 큰 몫입니다.",
          "chars": 26
        },
        {
          "field": "이득",
          "text": "이처럼 세 구간은 돈이 나가는 곳이 전혀 다릅니다.",
          "chars": 28
        },
        {
          "field": "이득",
          "text": "한꺼번에 섞어 계산하면 겁만 주는 총액 하나가 나올 뿐입니다.",
          "chars": 34
        },
        {
          "field": "비고",
          "text": "확실히 받는 돈부터 넣고 나서 얼마가 모자라는지 보세요.",
          "chars": 31
        },
        {
          "field": "비고",
          "text": "부모급여·아동수당·첫만남이용권은 제1항(받을 돈부터)에 있습니다.",
          "chars": 36
        },
        {
          "field": "비고",
