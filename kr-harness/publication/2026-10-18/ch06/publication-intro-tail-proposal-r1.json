  "operations": [
    {
      "target": "intro.md",
      "status": "proposed_pending_independent_exact_hash_review",
      "original_sha256": "877b053882043510e21e7bd60fa5e1538f093b415ce79ada7924af5076ad3af3",
      "original_byte_length": 2798,
      "before": "싸고 효과도 있어 보이는 제품과 행동을 모았습니다. 원래 연구를 보면 이득이 0에 가깝거나 아예 0입니다. 오히려 손해인 경우도 있습니다. 순서를 정한 기준은 두 가지입니다. 사람들이 여기에 쓰는 돈이 많은가, 뒷받침하는 근거는 단단한가. 앞에 올수록 먼저 끊을 가치가 큽니다.",
      "after": "싸고 효과도 있어 보이는 제품과 행동을 모았습니다. 기대한 이득이 뚜렷하지 않거나 근거가 부족한 경우를 다룹니다. 일부에서는 이득과 해가 함께 보고됐습니다. 연구마다 대상과 방법, 살핀 결과가 다릅니다. 효과가 전혀 없다고 한데 묶어 단정할 수는 없습니다. 순서를 정한 기준은 두 가지입니다. 사람들이 여기에 쓰는 돈이 많은가, 뒷받침하는 근거는 단단한가. 지출을 줄일지는 각 항목의 대상과 예외를 보고 판단하세요.",
      "before_occurrences": 1,
      "byte_start": 216,
      "byte_end_exclusive": 589,
      "virtual_after_sha256": "f2b9a8206b47552d21ef44915e31f32ea64d2c3dce7bf14f4dd391cae3f1e541",
      "reason": "모든 항목을 이득0·일괄중단으로 묶는 도입부가 최신29개 안의 작은 이득·비유의·근거부족·대상별 예외와 충돌합니다. 단일 설계나 결과가 전체에 공통이라고 일반화하지 않습니다.",
      "modified_sentence_lengths_python_len": [
        {
          "text": "싸고 효과도 있어 보이는 제품과 행동을 모았습니다.",
