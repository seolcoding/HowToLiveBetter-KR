<section id="content">
    <div class="content-wrap pb-0">
        <div class="container">
            <div class="row">
                <div class="col-12 col-md-2">
                    <h3 class="mb-3 fw-bolder">유관기관</h3>
                </div>
                <div class="col-12 col-md-10">
                    <div class="owl-carousel events-carousel carousel-widget owl-loaded owl-drag position-relative" id="content-start" data-margin="20" data-pagi="false" data-items="1" data-items-lg="4" data-items-xl="4">
                        <div class="owl-stage-outer institution">
                            <div class="owl-stage mt-2" style="transform: translate3d(0px, 0px, 0px); transition: all 0.25s ease 0s; width: 1370px">
                                <div class="owl-item" style="width: 254px; margin-right: 20px">
                                    <div class="oc-item item-109">
                                        <article class="entry">
                                            <div class="grid-inner bg-contrast-0 row g-0 border-0 rounded-5 shadow-sm h-shadow all-ts h-translate-y-sm">
                                                <a href="https://www.lifeline.or.kr/business/opening_consult.php" target="_blank" title="생명의 전화 바로가기" class="d-block">
                                                    <div class="col-12 pt-0">
                                                        <div class="card d-block border-0 dark shadow-sm h-shadow shadow-ts p-2 pointer-hover" style="background: linear-gradient(rgba(0,0,0,.7), rgba(0,0,0,.4)), url('/resources/images/background/109Card1.jpg') no-repeat top center / cover;" data-bs-theme="dark" alt=" ">
                                                            <div class="card-body pointer-hover">
                                                                <i class="h2 bi-heart-pulse pointer-hover"><span class="sr-only">생명의 전화</span></i>
                                                                <h3 class="card-title h4 fw-bold mb-0 text-white pointer-hover">생명의 전화(1588-9191)</h3>
