  "entries": [
    {
      "number": 1,
      "heading": "### 1. 금연하세요. 빨리 끊을수록 좋습니다",
      "run_dir": "_workspace/2026-10-18-001-1c88",
      "input_sha256": "7b41f74e1c6e1ccaabc6ebf19e3906504e0cda79c6e42e14529c08065c11fdde",
