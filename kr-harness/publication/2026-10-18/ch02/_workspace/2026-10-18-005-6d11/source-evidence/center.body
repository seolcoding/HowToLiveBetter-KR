            <div class="modal fade modal-contents modal-qscg-find-a-service-agency"
                 id="MODAL_QSCG_FIND_A_SERVICE_TEST" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable" style="width: 1000px">
                    <div class="modal-content" style="border: 1px solid #ccc">
                        <div class="modal-header">
                            <h3 class="modal-title">정보 수정 요청</h3>
                            <div class="buttons-wrap">
                                <button type="button" class="btn-icon-full" aria-label="닫기" onclick="onClickCloseUpdateRequestModal()">
                                    <img src="/resources/img/common/modal-close.png" alt="">
                                </button>
                            </div>
                        </div>

                        <div class="modal-body">
                            <form>
                                <p class="required-legend"><span class="required">*</span> 표시는 필수 입력 항목입니다.</p>
                                <div class="table-wrap form-type">
                                    <table class="table">
                                        <tbody>
                                            <tr>
                                                <td colspan="3">
                                                    <label class="form-label">보건소명 <span class="required">*</span></label>
                                                    <input id="institutionName" type="text" class="form-control">
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="3">
                                                    <label class="form-label">주소 <span class="required">*</span></label>
                                                    <div class="input-group gap w-75">
                                                        <input id="address" type="text" class="form-control" readonly>
                                                        <button type="button" class="btn btn-dark" onclick="searchAddress()">
                                                            주소검색
                                                        </button>
                                                    </div>
                                                    <input id="detailAddress" type="text" class="form-control">
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="3">
                                                    <label class="form-label">연락처 <span class="required">*</span></label>
                                                    <input id="tel" type="text" class="form-control">
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="3">
                                                    <label class="form-label">요청사항 <span class="required">*</span></label>
                                                    <input id="demandMatter" type="text" class="form-control">
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="button-block-wrap">
                                    <button type="button" class="btn btn-outline-secondary fw-med BTN_SUBMIT" onclick="onclickModification()">
                                        요청하기
                                    </button>
                                    <button type="button" class="btn btn-primary BTN_CANCEL" onclick="onClickCloseUpdateRequestModal()">
                                        취소
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
<script>

    let selectInstitutionInfo = {
        institutionNo: 0,
        institutionName: ''
    }

    // 하위 함수는 모두 정보수정요청 Modal에 관한 함수들
    // 모달 열기
    const onClickUpdateRequest = (no, name) => {
        selectInstitutionInfo.institutionNo = no
        selectInstitutionInfo.institutionName = name
        $('#institutionName').val(name)
        $("#MODAL_QSCG_FIND_A_SERVICE_TEST").modal("show");
    }

    // 모달 닫기
    const onClickCloseUpdateRequestModal = () => {
        selectInstitutionInfo.institutionNo = 0
        selectInstitutionInfo.institutionName = ''
        $("#MODAL_QSCG_FIND_A_SERVICE_TEST").modal("hide");
    }

    //KaKao 주소 검색
    const searchAddress = () => {
        new daum.Postcode({
            oncomplete: function (data) {
                document.getElementById("address").value = data.address;
            },
        }).open();
    };

    // data reset
    const resetContentsData = () => {
        $('#address').val('')
        $('#institutionName').val('')
        $('#detailAddress').val('')
        $('#tel').val('')
        $('#demandMatter').val('')
    }

    // ============================ API
    // 정보수정요청
    const onclickModification = async () => {
        const payload = {
            institutionNo: Number(selectInstitutionInfo.institutionNo),
            institutionName: $('#institutionName').val(),
            address: $('#address').val(),
            detailAddress: $('#detailAddress').val(),
            tel: $('#tel').val(),
            demandMatter: $('#demandMatter').val()
        }

        if (!payload.institutionNo || !payload.institutionName || !payload.address || !payload.detailAddress || !payload.tel || !payload.demandMatter) {
            handleServerErrorMessage({ message: '필수 항목을 입력해주세요' });
            return
        }

        try {
            await Api.post(`/supports/modification`, payload);
            resetContentsData()
            onClickCloseUpdateRequestModal()
        } catch (error) {
            handleServerErrorMessage(error);
        }
    }

</script>



<script src="/resources/js/pages/helpness/home.js"></script>

