        <div class="print-share-wrap">
            <a class="BTN_SHARE" href="javascript:void(0);" role="button" aria-haspopup="true" aria-expanded="false" aria-controls="shareLinkBox">
                <span class="a11yHidden">공유하기</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                    <path fill-rule="evenodd"
                        d="M15.75 4.5a3 3 0 1 1 .825 2.066l-8.421 4.679a3.002 3.002 0 0 1 0 1.51l8.421 4.679a3 3 0 1 1-.729 1.31l-8.421-4.678a3 3 0 1 1 0-4.132l8.421-4.679a3 3 0 0 1-.096-.755Z"
                        clip-rule="evenodd" />
                </svg>
            </a>
            <div class="BTN_SHARE_BOX" id="shareLinkBox">
                <div class="SHARE_LINK_BOX">
                    <a href="javascript:shareOnFacebook();" title="페이스북 새창열림"><img
                            src="/resources/img/icon_2/share/share_facebook.svg" alt="페이스북" /></a>
                    <a href="javascript:shareOnX();" title="엑스 새창열림"><img src="/resources/img/icon_2/share/share_x.svg"
                            alt="엑스" /></a>
                    <a href="javascript:shareOnKakao();" title="카카오스토리 새창열림"><img
                            src="/resources/img/icon_2/share/share_kakao.svg" alt="카카오스토리" /></a>
                    <a href="javascript:copyLink();" title="링크 복사"><img
                            src="/resources/img/icon_2/share/share_url.svg" alt="링크복사" /></a>
                </div>
            </div>
            <a class="btn-print BTN_PRINT" href="javascript:void(0);">
                <span class="a11yHidden">프린트하기</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                    <path fill-rule="evenodd"
                        d="M7.875 1.5C6.839 1.5 6 2.34 6 3.375v2.99c-.426.053-.851.11-1.274.174-1.454.218-2.476 1.483-2.476 2.917v6.294a3 3 0 0 0 3 3h.27l-.155 1.705A1.875 1.875 0 0 0 7.232 22.5h9.536a1.875 1.875 0 0 0 1.867-2.045l-.155-1.705h.27a3 3 0 0 0 3-3V9.456c0-1.434-1.022-2.7-2.476-2.917A48.716 48.716 0 0 0 18 6.366V3.375c0-1.036-.84-1.875-1.875-1.875h-8.25ZM16.5 6.205v-2.83A.375.375 0 0 0 16.125 3h-8.25a.375.375 0 0 0-.375.375v2.83a49.353 49.353 0 0 1 9 0Zm-.217 8.265c.178.018.317.16.333.337l.526 5.784a.375.375 0 0 1-.374.409H7.232a.375.375 0 0 1-.374-.409l.526-5.784a.373.373 0 0 1 .333-.337 41.741 41.741 0 0 1 8.566 0Zm.967-3.97a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75H18a.75.75 0 0 1-.75-.75V10.5ZM15 9.75a.75.75 0 0 0-.75.75v.008c0 .414.336.75.75.75h.008a.75.75 0 0 0 .75-.75V10.5a.75.75 0 0 0-.75-.75H15Z"
                        clip-rule="evenodd" />
                </svg>
