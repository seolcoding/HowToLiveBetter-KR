        <script src="https://developers.kakao.com/sdk/js/kakao.min.js"></script>

        <script>
            if (typeof Kakao !== "undefined" && !Kakao.isInitialized()) {
                Kakao.init("458fbff26d3496fa0bb4ef321c8cbb23");
            }

            function shareOnKakao() {
                const url = location.href;
                const title = $("title").text();
                Kakao.Link.sendDefault({
                    throughTalk: false,
                    objectType: 'feed',
                    content: {
                        title: $("title").text(),
                        imageUrl: 'http://www.nosmokeguide.go.kr/images/mobilelogo.png',
                        link: {
                            mobileWebUrl: url,
                            webUrl: url
                        }
                    },
                    buttons: [
                        {
                            title: '웹으로 보기',
                            link: {
                                mobileWebUrl: url,
                                webUrl: url
                            }
                        }
                    ]
                });
            }

            function shareOnFacebook() {
                const url = 'https://nosmokeguide.go.kr/main';
                const facebookShareUrl = "https://www.facebook.com/sharer/sharer.php?u=" + url;
                window.open(facebookShareUrl, '_blank', 'width=600,height=400');
            }

            function shareOnX() {
                const url = location.href;
                const title = encodeURIComponent($("title").text());
                window.open("https://twitter.com/intent/tweet?text=" + encodeURIComponent("[금연길라잡이]") + title + ":" + "&url=" + url);
            }

            function copyLink() {
                window.prompt("아래의 URL을 복사하여 사용하실수 있습니다.", location.href);
            }

            // 공유하기 버튼 키보드 접근성(disclosure) - 마우스 hover 동작은 그대로 보존, 키보드/클릭 토글만 추가
            (function () {
                const shareWrap = document.querySelector(".print-share-wrap");
                if (!shareWrap || shareWrap.dataset.shareA11yBound === "true") return;
                shareWrap.dataset.shareA11yBound = "true";

                const shareToggle = shareWrap.querySelector(".BTN_SHARE");
                const shareBox = shareWrap.querySelector(".BTN_SHARE_BOX");
                if (!shareToggle || !shareBox) return;

                const shareLinks = shareBox.querySelectorAll("a");

                const isShareOpen = () => shareWrap.classList.contains("is-share-open");

                const openShareBox = (focusFirst) => {
                    shareWrap.classList.add("is-share-open");
                    shareToggle.setAttribute("aria-expanded", "true");
                    if (focusFirst && shareLinks.length) shareLinks[0].focus();
                };

                const closeShareBox = (returnFocus) => {
                    shareWrap.classList.remove("is-share-open");
                    shareToggle.setAttribute("aria-expanded", "false");
                    if (returnFocus) shareToggle.focus();
                };

                // viaKeyboard=true 일 때만 초점을 박스 안/호출 버튼으로 이동(마우스 동작 보존)
                const toggleShareBox = (viaKeyboard) => {
                    if (isShareOpen()) closeShareBox(viaKeyboard);
                    else openShareBox(viaKeyboard);
                };

                // Enter 는 <a> 기본 활성화로 click 이 발생(키보드 click 은 detail 0)
                shareToggle.addEventListener("click", (event) => {
                    event.preventDefault();
                    toggleShareBox(event.detail === 0);
                });

                // Space 는 링크에서 기본 활성화되지 않으므로 별도 처리
                shareToggle.addEventListener("keydown", (event) => {
                    if (event.key === " " || event.key === "Spacebar" || event.keyCode === 32) {
                        event.preventDefault();
                        toggleShareBox(true);
                    }
                });

                // ESC 로 닫고 호출 버튼으로 초점 복귀
                shareWrap.addEventListener("keydown", (event) => {
                    if ((event.key === "Escape" || event.key === "Esc" || event.keyCode === 27) && isShareOpen()) {
                        event.preventDefault();
                        closeShareBox(true);
                    }
                });

                // 영역 밖으로 초점이 빠져나가면 닫기
                shareWrap.addEventListener("focusout", (event) => {
                    if (isShareOpen() && !shareWrap.contains(event.relatedTarget)) {
                        closeShareBox(false);
                    }
                });
            })();

        </script>
            </div>
        </div>
    </div>


    <section>
        <div class="container container-1200">
            <h3 class="d-none">지역금연센터 소개 섹션</h3>

            <div class="" style="display: flex; align-items: end !important; justify-content: end !important;">
                <button type="button" style="margin: 0 !important;" class="btn btn-outline-dark fw-med ms-auto" onclick="redirectToForm('지역금연지원센터')" id="local-smoking-cessation-support-center">
                    예약하기
                </button>

                <button type="button" style="margin-left: 10px !important;" class="btn btn-outline-dark fw-med ms-auto btn-find-a-service-agency communityCenter">서비스 기관 찾기</button>
            </div>

            <article class="mt-20" id="basicHtmlContents">
                <h4>기본정보</h4>

                <div class="text-wrap mt-30">
                    <div class="table-wrap list-type">
                        <table class="table">
                            <caption class="a11yHidden">대상, 이용기간, 이용방법, 서비스 내용, 운영기관, 이용금액 문의처 정보를 제공합니다.</caption>
                            <colgroup>
                                <col style="width: 25%;">
                                <col>
                            </colgroup>
                            <tbody>
                                <tr>
                                    <th scope="row">대상</th>
                                    <td>
                                        중증·고도 흡연자 / 주거, 교육, 사업장 등에서 생활하는 흡연자군
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">이용기간</th>
                                    <td>
                                        평일(월-금) 오전 9시~오후 6시(금연캠프는 별도 문의)
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">이용방법</th>
                                    <td>
                                        가까운 지역금연지원센터에 문의
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">서비스 내용</th>
                                    <td>
                                        4박 5일 간 대상자 집중 금연치료 / 6개월 간, 9회 이상 금연상담 및 금연상태 평가(CO 또는 코티닌 측정)
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">운영기관</th>
                                    <td>
                                        전국 17개 지역금연지원센터
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">이용금액</th>
                                    <td>
                                        무료
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">문의처</th>
                                    <td>
                                        각 지역 금연지원센터
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div><!-- .table-wrap -->
                </div>
            </article>


            <article class="mt-60 d-none" id="videoContent">
                <h4>소개영상</h4>

                <div class="aspect-ratio--16-9-box mt-30">
                    <div class="video-wrap">
                        <video width="100%" height="100%" controls="" controlslist="nodownload">
                            <source src="/resources/video/2017_금연광고_금연캠프_편_15B_720p.mp4" type="video/mp4">
                        </video>
                    </div><!-- .video-wrap -->
                </div>
            </article>


            <article class="mt-60" id="detailHtmlContents">
                <h4>상세내용</h4>

                <div class="text-wrap mt-30">
                    <span class="fw-sbold">○ 지역금연지원센터는?</span><br>
                    전국 17개 금연지원센터를 통해 보건소나 병원 등에서 금연지원서비스를 이용하기 어려운 흡연자를 위하여 지역 맞춤형 금연서비스를 지원합니다.<br>
                    <br>
                    스스로의 의지만으로는 금연성공이 어려운 중증･고도 흡연자, 반복 재흡연자, 금연이 시급한 급･만성질환자에게 체계적･전문적 금연서비스를 지원합니다.<br>
                    또한, 임대주택, 학교, 사업장 등을 중심으로 금연환경 조성과 금연서비스를 제공합니다.<br>
                </div><!-- .text-wrap -->
            </article>


            <article class="mt-60" id="programHtmlContents">
                <h4>프로그램 개요</h4>

                <div class="text-wrap mt-30">
                    <span class="fw-sbold">○ 금연캠프</span><br>
                    금연캠프는 반복 재흡연자나 중증·고도 흡연자, 급·만성질환을 가진 흡연자가 4박 5일간 금연치료와 상담을 받는 집중 금연지원서비스입니다.<br>
                    금연두드림 홈페이지와 가까운 지역금연지원센터에 의뢰하여 신청할 수 있습니다.<br>
                    금연서비스는 니코틴보조제, 금연치료제, 행동강화물품 제공과 함께 건강상태 평가, 금연교육, 금연·심리상담, 운동프로그램 등을 진행하며, 총 6개월간 서비스를
                    제공합니다.<br>
                    <br>
                    <span class="fw-sbold">○ 입원환자 금연지원서비스</span><br>
                    입원환자 금연지원서비스는 입원 중인 흡연자 중 의사가 금연을 권고했거나, 과거 금연시도 경험이 있고 금연의지가 있는 환자에게 제공하는 금연지원서비스입니다.<br>
                    입원 중 대면상담, 니코틴보조제, 금연치료제, 행동강화물품을 제공하고, 퇴원 후에는 외래진료 시 센터에 방문하여 금연치료와 상담을 6개월간 받을 수 있습니다.<br>
                    <br>
                    <span class="fw-sbold">○ 생활터 금연환경 조성</span><br>
                    생활터 금연환경 조성은 주거·교육·근로 환경 등에서 금연실천이 어려운 흡연자 군, 주 생활지에 금연환경을 조성하고 맞춤형 금연지원서비스를 제공하는 프로그램입니다.<br>
                    6개월간 금연상담 및 금연상태평가(CO 또는 코티닌 측정), 행동강화물품 등을 지원합니다.<br>
                </div><!-- .text-wrap -->
            </article>

        </div><!-- .container -->
    </section>
</main>


    
        
            

