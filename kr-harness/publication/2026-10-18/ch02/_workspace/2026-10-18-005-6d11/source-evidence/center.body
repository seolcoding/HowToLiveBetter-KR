<body>
<a href="#mainContent" class="skip-to-content">본문 바로가기</a>
<!-- 추가 코드 (군길라잡이에서 유입 된 경우 Header 교체) -->

    
    
        



<div class="sky-popup-container" style="display: none" role="region" aria-label="알림 팝업">
  <div class="bg-container">
    <div class="content-wrap">
      <div class="prev-btn-box" role="button" tabindex="0" aria-label="이전 알림" onkeydown="handleSkyPopupKeyActivation(event)">
        <div class="img-box">
          <img src="/resources/img/sky_popup_prev_btn_arrow.png" alt="이전"/>
        </div>
      </div>
      <div class="swiper-wrap swiper-area">
        <div class="swiper">
          <div class="swiper-wrapper"></div>
        </div>
      </div>
      <div class="next-btn-box" role="button" tabindex="0" aria-label="다음 알림" onkeydown="handleSkyPopupKeyActivation(event)">
        <div class="img-box">
          <img src="/resources/img/sky_popup_next_btn_arrow.png" alt="다음"/>
        </div>
      </div>
    </div>
    <div class="banner-footer-box">
      <div class="align-box">
        <div class="slider-control-box">
          <p class="swiper-page"></p>
          <div class="pause-btn-box" role="button" tabindex="0" aria-label="자동 재생 정지" onkeydown="handleSkyPopupKeyActivation(event)">
            <img src="/resources/img/sky_popup_pause_btn.png" alt=""/>
          </div>
        </div>
        <div class="today-show-box">
          <label>
            <input name="todaySkyPopup" type="checkbox">
            하루 동안 열지 않기
          </label>
        </div>
      </div>
    </div>
  </div>
  <div class="sky-popup-close-box">
    <div class="close-btn" role="button" tabindex="0" aria-label="알림 팝업 닫기"
         onclick="onClickClosePopup()" onkeydown="handleSkyPopupKeyActivation(event)">
      <p>팝업닫기</p>
      <div class="popup-close-btn">
        <img src="/resources/img/sky_popup_close_btn_arrow.png" alt="팝업닫기"/>
      </div>
    </div>
  </div>
</div>
<div class="sky-popup-open-box" style="display: none;">
  <div class="open-btn" role="button" tabindex="0" aria-label="알림 팝업 열기"
       onclick="onClickOpenPopup()" onkeydown="handleSkyPopupKeyActivation(event)">
    <p>팝업열기</p>
    <div class="popup-open-btn">
      <img src="/resources/img/sky_popup_close_btn_arrow.png" alt="팝업열기"/>
    </div>
  </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // 브라우저 자동 scroll 복원 방지
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }

        initFunc();
    });

    // 초기화
    const initFunc = () => {

        const isMain = checkUrl();
        const isTodayVisible = getTodayCookie();
        // 메인 페이지가 아니면 팝업과 버튼 모두 숨김
        if (!isMain) {
            document.querySelector(".sky-popup-container").style.display = 'none';
            document.querySelector(".sky-popup-open-box").style.display = 'none';
        } else {
            getSkyPopupList();
        }

    }

    // 메인페이지에만 노출되게끔
    const checkUrl = () => {
        const path = window.location.pathname;
        return path === '/' || path === '/main';
    }

    // Swiper 초기화
    const initSwiper = () => {
        // Swiper page setting
        function updateSwiperPage(swiper) {
            const current = swiper.realIndex + 1;
            const total = swiper.slides.length - 0;
            document.querySelector('.swiper-page').textContent = `${current} / ${total}`;
        }

        // Swiper 초기화
        const swiperInstance = new Swiper('.swiper-area .swiper', {
            loop: true,
            slidesPerView: 2,
            autoplay: {
                delay: 3000,
                disableOnInteraction: false,
            },
            navigation: {
                nextEl: '.next-btn-box',
                prevEl: '.prev-btn-box',
            },
            on: {
                init: function () {
                    updateSwiperPage(this)
                    updateSkyPopupSlideTabIndex()
                },
                slideChange: function () {
                    updateSwiperPage(this)
                },
                slideChangeTransitionEnd: function () {
                    updateSkyPopupSlideTabIndex()
                }
            }
        });

        $(document).on('click', '.pause-btn-box', function () {
            if (swiperInstance.autoplay.running) {
                swiperInstance.autoplay.stop(); // 자동 재생 정지
            } else {
                swiperInstance.autoplay.start(); // 자동 재생 시작
            }
            updateSkyPopupPauseLabel();
        });
        // 웹접근성(항목1): 정지/재생 상태를 대체텍스트(aria-label)로 구분
        updateSkyPopupPauseLabel();
    }

    // 자동 재생 상태에 따라 정지/재생 버튼의 대체텍스트 갱신
    const updateSkyPopupPauseLabel = () => {
        const box = document.querySelector('.pause-btn-box');
        if (!box || typeof swiperInstance === 'undefined' || !swiperInstance || !swiperInstance.autoplay) return;
        box.setAttribute('aria-label', swiperInstance.autoplay.running ? '자동 재생 정지' : '자동 재생 시작');
    }

    // 스카이 팝업이 현재 노출 상태인지
    const isSkyPopupOpen = () => {
        const el = document.querySelector(".sky-popup-container");
        return el && el.style.display !== 'none';
    }

    // 스카이 팝업 내 close-btn 으로 초점 이동
    const focusSkyPopupCloseBtn = () => {
        const closeBtn = document.querySelector(".sky-popup-container .close-btn");
        if (closeBtn) closeBtn.focus();
    }

    // 스카이 팝업 닫혔을 때 open-btn 으로 초점 이동
    const focusSkyPopupOpenBtn = () => {
        const openBtn = document.querySelector(".sky-popup-open-box .open-btn");
        if (openBtn) openBtn.focus();
    }

    // role="button" 요소에 대한 Enter/Space 키 활성화 처리
    function handleSkyPopupKeyActivation(event) {
        if (event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar') {
            event.preventDefault();
            event.currentTarget.click();
        }
    }

    /**
     * 웹접근성: 현재 화면에 보이는 슬라이드(swiper-slide-active, swiper-slide-next)의
     * popup-detail-box 만 Tab 으로 접근 가능하게 하고, 비활성/복제 슬라이드의 detail-box 는
     * Tab 순서에서 제외한다. (loop:true + slidesPerView:2 환경에서 화면 밖 detail-box 로
     * 초점이 흘러 Tab 이 멈추는 것처럼 보이는 문제 해결)
     */
    function updateSkyPopupSlideTabIndex() {
        const slides = document.querySelectorAll('.sky-popup-container .swiper-slide');
        slides.forEach(function (slide) {
            const detail = slide.querySelector('.popup-detail-box');
            if (!detail) return;
            detail.setAttribute('tabindex', '0');
        });
    }

    // 팝업 열기
    function onClickOpenPopup() {
        document.querySelector(".sky-popup-container").style.display = 'block';
        document.querySelector(".sky-popup-open-box").style.display = 'none';
        // 열린 직후 닫기 버튼으로 초점 이동
        focusSkyPopupCloseBtn();
    }

    // 팝업 닫기
    const onClickClosePopup = () => {
        const isChecked = $('input[name="todaySkyPopup"]').is(':checked');
        if (isChecked) {
            setTodayCookie('true', 1);
        } else {
            deleteTodayCookie(); // 쿠키 삭제
        }
        document.querySelector(".sky-popup-container").style.display = 'none';
        document.querySelector(".sky-popup-open-box").style.display = 'block';
        // 웹접근성(항목11): 닫은 직후 '본문 바로가기'(skip-nav)로 초점 이동 (없으면 열기 버튼)
        const skipNav = document.querySelector(".skip-to-content");
        if (skipNav) skipNav.focus();
        else focusSkyPopupOpenBtn();
    }

    // ESC 키로 팝업 닫기 지원
    // (다른 Bootstrap 모달이 열려 있는 경우에는 그 모달의 ESC 처리를 방해하지 않도록 스킵)
    document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        if (!checkUrl() || !isSkyPopupOpen()) return;
        if (document.querySelector('.modal.show')) return;
        onClickClosePopup();
    });

    // 쿠키 세팅
    const setTodayCookie = (value, days) => {
        const expires = new Date();
        expires.setDate(expires.getDate() + days);
        document.cookie = `isSkyPopupToday=${value}; path=/; expires=${expires.toUTCString()}`;


    }

    // 쿠키 삭제
    const deleteTodayCookie = () => {
        document.cookie = "isSkyPopupToday=; path=/; expires=Thu, 01 Jan 1970 00:00:00 UTC;";
    };

    // 쿠키 가져오기
    const getTodayCookie = () => {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; isSkyPopupToday=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
        return null;
    }

    // 페이지 이동
    const onClickMovePage = (url) => {
        window.location.href = url
    }
    // ================================ API
    // 스카이 팝업 목록 조회하기
    const getSkyPopupList = () => {
        Api.get("/popups/skys/expose")
            .then(response => {
                const targetElement = $('.content-wrap .swiper-area .swiper .swiper-wrapper');
                if (response.data.data.length > 0) {
                    response.data.data.forEach((skyPopupItem) => {
                        const isLinkArea = skyPopupItem.isLinkUsed ?
                            `
                                <div class="popup-detail-box" role="button" tabindex="0" aria-label="자세히 보기"
                                     onclick="onClickMovePage('${skyPopupItem.popupLinkUrl}')">
                                    <p class="title">자세히 보기</p>
                                    <div class="img-box">
                                        <img src="/resources/img/sky_popup_detail_arrow.png" alt="" />
                                    </div>
                                </div>
                            `
                            :
                            ''
                        targetElement.append(
                            `
                                    <div class="swiper-slide">
                                        <div class="popup-item">
                                            <div class="popup-content-box">
                                                <div class="img-box">
                                                    <img src="/resources/img/sky_popup_bell.png" alt="" />
                                                </div>
                                                <div class="txt-box">
                                                    <p class="title">${skyPopupItem.popupTitle}</p>
                                                    <p class="content">${skyPopupItem.popupContent}</p>
                                                </div>
                                            </div>
                                            ${isLinkArea}
                                        </div>
                                    </div>
                                `
                        )
                    })
                    initSwiper();

                    if (getTodayCookie() === 'true') {
                        document.querySelector(".sky-popup-container").style.display = 'none';
                        document.querySelector(".sky-popup-open-box").style.display = 'block';
                    } else {
                        document.querySelector(".sky-popup-container").style.display = 'block';
                        document.querySelector(".sky-popup-open-box").style.display = 'none';
                        // 페이지 로딩 시 자동 노출되는 경우 닫기 버튼으로 초점 진입
                        setTimeout(focusSkyPopupCloseBtn, 0);
                    }
                } else {
                    document.querySelector(".sky-popup-container").style.display = 'none';
                    document.querySelector(".sky-popup-open-box").style.display = 'none';
                }

                console.log('==========================response', response)
            })
            .catch(error => {
                handleServerErrorMessage(error);
                document.querySelector(".sky-popup-container").style.display = 'none';
                document.querySelector(".sky-popup-open-box").style.display = 'none';
            });
    }
</script>

<style>
    div.sky-popup-open-box {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10000;
        /* 아래는 닫기 버튼과 동일한 스타일 */
        width: 104px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;

        div.open-btn {
            display: flex;
            align-items: center;
            width: 104px;
            height: 38px;
            box-shadow: 0 2px 4px 0 #00000014;
            border-width: 0 1px 1px 1px;
            border-style: solid;
            border-color: #D9D9D9;
            border-radius: 0 0 12px 12px;
            background-color: #ffffff;
            cursor: pointer;

            p {
                margin-bottom: 0;
                font-size: 14px;
                font-weight: 500;
                color: #222222;
                margin-left: 20px;
            }

            div.popup-open-btn {
                width: 24px;

                img {
                    display: block;
                    width: 100%;
                }
            }
        }
    }

    /* 웹접근성: 키보드 포커스 표시 */
    .sky-popup-container [role="button"]:focus-visible,
    .sky-popup-container [role="button"]:focus,
    .sky-popup-open-box [role="button"]:focus-visible,
    .sky-popup-open-box [role="button"]:focus,
    .sky-popup-container input[type="checkbox"]:focus-visible,
    .sky-popup-container input[type="checkbox"]:focus {
        outline: 2px solid #1d6fff;
        outline-offset: 2px;
    }

    .sky-popup-container .today-show-box label {
        cursor: pointer;
    }

    /* 웹접근성(항목12): 체크박스 컨트롤 최소 크기 17x17px 보장 */
    .sky-popup-container .today-show-box input[type="checkbox"] {
        width: 17px;
        height: 17px;
    }

    div.sky-popup-container {
        width: 100%;
        height: 250px;
        position: relative;
        z-index: 9999;

        div.bg-container {
            width: 100%;
            height: 100%;
            background-image: url("../../resources/img/sky_popup_bg.png");
            background-repeat: no-repeat;
            background-position: center;
            background-size: cover;

            div.content-wrap {
                max-width: 1520px;
                margin: 0 auto;
                display: flex;
                align-items: center;

                div.swiper-wrap {
                    flex: 1;
                    min-width: 0;
                    overflow: hidden;
                    height: 100%;

                    div.swiper {
                        height: 100%;

                        div.swiper-wrapper {
                            height: 100%;

                            div.swiper-slide {
                                div.popup-item {
                                    display: flex;
                                    flex-direction: column;
                                    justify-content: space-between;
                                    height: 100%;
                                    padding: 40px 75px 56px 75px;

                                    div.popup-content-box {
                                        display: flex;

                                        div.img-box {
                                            width: 72px;
                                            margin-right: 16px;

                                            img {
                                                transform: none !important;
                                                display: block;
                                                width: 100%;
                                            }
                                        }

                                        div.txt-box {
                                            flex: 1;
                                            min-width: 0;
                                            p {
                                                &.title {
                                                    font-size: 24px;
                                                    font-weight: 700;
                                                    color: #222222;
                                                    margin-bottom: 8px;
                                                    white-space: nowrap;
                                                    overflow: hidden;
                                                    text-overflow: ellipsis;
                                                }

                                                &.content {
                                                    font-size: 16px;
                                                    font-weight: 400;
                                                    color: #222222;
                                                    line-height: 24px;
                                                    white-space: nowrap;
                                                    overflow: hidden;
                                                    text-overflow: ellipsis;
                                                }
                                            }
                                        }
                                    }

                                    div.popup-detail-box {
                                        display: flex;
                                        align-items: center;
                                        justify-content: end;
                                        cursor: pointer;

                                        p.title {
                                            font-size: 16px;
                                            font-weight: 500;
                                            color: #222222;
                                            margin-bottom: 0;
                                            margin-top: 5px;
                                            margin-right: 5px;
                                        }

                                        div.img-box {
                                            width: 90px;

                                            img {
                                                display: block;
                                                width: 100%;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                div.prev-btn-box {
                    div.img-box {
                        width: 52px;
                        cursor: pointer;

                        img {
                            display: block;
                            width: 100%;
                        }
                    }
                }

                div.next-btn-box {
                    div.img-box {
                        width: 52px;
                        cursor: pointer;

                        img {
                            display: block;
                            width: 100%;
                        }
                    }
                }
            }

            div.banner-footer-box {
                div.align-box {
                    max-width: 1520px;
                    margin: 0 auto;
                    display: flex;
                    align-items: center;
                    justify-content: space-between;

                    div.slider-control-box {
                        display: flex;
                        align-items: center;

                        p.swiper-page {
                            font-size: 16px;
                            font-weight: 400;
                            color: #222222;
                            margin-bottom: 0;
                            margin-right: 5px;
                        }

                        div.pause-btn-box {
                            width: 18px;
                            cursor: pointer;

                            img {
                                display: block;
                                width: 100%;
                            }
                        }
                    }

                    div.today-show-box {
                        font-size: 16px;
                        font-weight: 500;
                        color: #767676;
                    }
                }
            }
        }

        div.sky-popup-close-box {
            position: absolute;
            bottom: -38px;
            left: 50%;
            transform: translateX(-50%);

            div.close-btn {
                display: flex;
                align-items: center;
                width: 104px;
                height: 38px;
                box-shadow: 0 2px 4px 0 #00000014;
                border-width: 0 1px 1px 1px;
                border-style: solid;
                border-color: #D9D9D9;
                border-radius: 0 0 12px 12px;
                background-color: #ffffff;
                cursor: pointer;

                p {
                    margin-bottom: 0;
                    font-size: 14px;
                    font-weight: 500;
                    color: #222222;
                    margin-left: 20px;
                }

                div.popup-close-btn {
                    width: 24px;

                    img {
                        display: block;
                        width: 100%;
                    }
                }
            }
        }
    }
</style>
        



<header id="header">

    <div class="user-content-wrapper web-area topbar">
        <div class="container user-content">

        </div>
    </div>

    
    <nav class="layout-content web-area">
        <div class="container gnb-wrapper flex-center">
            <h1 id="logo">
                <span class="a11yHidden">금연 길라잡이</span>
                <a href="/main">
                    <img src="/resources/img/logo/header-logo.svg" alt="금연 길라잡이 로고">
                </a>
            </h1>

            <div class="gnb-right-wrap">
                <ul class="header-menu">
                </ul>

                <div class="family-site-wrap">
                    <select id="FAMILY_SITE_SELECT" class="form-select family-site" title="패밀리사이트">
                        <option>패밀리사이트</option>
                    </select>
                    <button type="button" id="FAMILY_SITE_GO" class="btn btn-dark family-site-go" title="새 창 열림">이동</button>
                </div>

                <div class="search-menu-button-wrap">
                    
                    <div class="search-layer" style="height: auto;">
                        <div class="container">
                            <div class="search-form-wrap">
                                <div class="search-form">
                                    <input id="keyword" type="search" class="form-control input-keyword" value="" required
                                           placeholder="검색어를 입력해주세요." title="검색어 입력"
                                    >
                                    <button type="button" class="btn btn-outline-primary btn-icon-full btn-search" onclick="moveSearchPage()">
                                        <img src="/resources/img/icon_2/header-input-search.svg" alt="검색">
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="button" class="btn btn-dark search" title="통합검색" onclick="headerToggleSearchLayer(event)">
                        <img src="/resources/img/icon_2/header-search.svg" aria-label="통합검색 열기">
                    </button>
                    <button type="button" class="btn btn-primary sitemap" title="사이트맵" onclick="gotoPage('/sitemap');">
                        <img src="/resources/img/icon_2/header-hamburger.svg" aria-label="사이트맵으로 이동">
                    </button>
                </div>
            </div>
        </div>
    </nav>

</header>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        initializeFunc()
        $('#keyword').on('keydown', function(event) {
            if (event.key === 'Enter' || event.keyCode === 13) {
                moveSearchPage();
            } else if (event.key === 'Escape') {
                headerCloseSearchLayer();
            }
        });
    })

    // 초기 진입시 실행
    const initializeFunc = () => {
        const loginStatus = Api.getAccessToken()
        headerSetting((loginStatus) ? 'login' : 'noLogin')
    }

    // Header Contents Setting
    const headerSetting = (type) => {
        const targetElement = $(".user-content")
        targetElement.empty()
        switch (type) {
            case 'login':
                targetElement.append(`
                    <ul class="login-wrap">
                        <li class="user-my-page-menu">
                            <a href="/mypage">마이페이지</a>
                        </li>
                        <li class="line item-divider">|</li>
                        <li class="user-login-menu">
                            <a href="javascript:void(0);" onclick="onClickLogOut();">로그아웃</a>
                        </li>
                        <li class="line item-divider">|</li>
                        <li class="screen-zoom">
                            <span class="label">화면크기</span>
                            <button class="btn-icon-full zoom-out"><img src="/resources/img/icon/icon-minus-button-black.svg" alt="축소"></button>
                            <span class="mag">100%</span>
                            <button class="btn-icon-full zoom-in"><img src="/resources/img/icon/icon-plus-button-black.svg" alt="확대"></button>
                        </li>
                    </ul>
                `)
                break;
            case 'noLogin':
                targetElement.append(`
                    <ul class="login-wrap">
                        <li class="user-my-page-menu">
                            <a href="/sign-up">회원가입</a>
                        </li>
                        <li class="line item-divider">|</li>
                        <li class="user-login-menu">
                            <a href='/login'>로그인</a>
                        </li>
                        <li class="line item-divider">|</li>
                        <li class="screen-zoom">
                            <span class="label">화면크기</span>
                            <button class="btn-icon-full zoom-out"><img src="/resources/img/icon/icon-minus-button-black.svg" alt="축소"></button>
                            <span class="mag">100%</span>
                            <button class="btn-icon-full zoom-in"><img src="/resources/img/icon/icon-plus-button-black.svg" alt="확대"></button>
                        </li>
                    </ul>
                `)
                break;
        }
    }

    // 로그아웃
    const onClickLogOut = () => {
         mlc_util.modalConfirm(`로그아웃 하시겠습니까?`, null, null, null, {
            OK: {
                callback: () => {
                    _handleLogout();
                },
            },
        });

        function _handleLogout() {
            let sessionTimerId = localStorage.getItem('sessionTimerId');
            clearInterval(sessionTimerId); // 타이머 중지
            localStorage.removeItem('sessionTimerId');
            sessionTimerId = null; // 타이머 ID 초기화
            localStorage.removeItem('integrate_set_expires_second');
            localStorage.removeItem('integrate_expires');
            localStorage.removeItem('accessToken')
            localStorage.removeItem('authInfo')
            sessionStorage.removeItem('authInfo');
            window.location.href = `/main`;
        }
    }

    /**
     * 검색 레이어 토글 트리거 기억용
     */
    let headerSearchLayerTrigger = null;

    /**
     * 검색 레이어 토글
     * 열릴 때: 검색 입력으로 초점 이동 (트리거 저장)
     * 닫힐 때: 트리거 버튼으로 초점 복귀
     */
    const headerToggleSearchLayer = (event) => {
        let layerEl = document.querySelector(".search-layer");
        const willOpen = !(layerEl.classList && layerEl.classList.contains("ON"));
        mlc_util.toggleClass(layerEl, "ON");

        if (willOpen) {
            if (event && event.currentTarget) {
                headerSearchLayerTrigger = event.currentTarget;
            }
            const keywordInput = document.getElementById("keyword");
            if (keywordInput) {
                setTimeout(() => keywordInput.focus(), 0);
            }
        } else {
            if (headerSearchLayerTrigger) {
                headerSearchLayerTrigger.focus();
                headerSearchLayerTrigger = null;
            }
        }
    }

    /**
     * 검색 레이어 닫기 (ESC, 외부 사용용)
     */
    const headerCloseSearchLayer = () => {
        const layerEl = document.querySelector(".search-layer");
        if (!layerEl || !layerEl.classList.contains("ON")) return;
        layerEl.classList.remove("ON");
        if (headerSearchLayerTrigger) {
            headerSearchLayerTrigger.focus();
            headerSearchLayerTrigger = null;
        }
    }

    function gotoPage(url, target) {
        if(target) window.open(target).location.href = url
        else location.href = url
    }

    const moveSearchPage = () => {
        const keywordStr = $('#keyword').val().trim()

        if (!keywordStr || keywordStr === '') {
            window.location.href = `/search`
        } else {
            window.location.href = `/search?keyword=${keywordStr}`
        }
    }
</script>
    


